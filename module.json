{
  "id": "pf2e-automatic-ability-resolution",
  "title": "PF2e Automatic Ability Resolution",
  "description": "Compiles PF2e's non-spell abilities (basic actions, monster abilities, and later class features and consumables) into plans the resolution core resolves, for live play and the Combat Simulator.",
  "version": "0.9.1",
  "url": "https://github.com/Theholycole/pf2e-automatic-ability-resolution",
  "manifest": "https://github.com/Theholycole/pf2e-automatic-ability-resolution/releases/latest/download/module.json",
  "download": "https://github.com/Theholycole/pf2e-automatic-ability-resolution/releases/download/v0.9.1/module.zip",
  "readme": "https://github.com/Theholycole/pf2e-automatic-ability-resolution#readme",
  "bugs": "https://github.com/Theholycole/pf2e-automatic-ability-resolution/issues",
  "license": "LICENSE",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "TheHolyCole"
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "pf2e",
        "type": "system",
        "compatibility": {
          "minimum": "8.5.0",
          "verified": "8.6.1"
        }
      }
    ],
    "requires": [
      {
        "id": "pf2e-resolution-core",
        "type": "module",
        "reason": "Abilities are resolved by the core's families.",
        "manifest": "https://github.com/Theholycole/PF2e-Automation-Core/releases/latest/download/module.json",
        "compatibility": {
          "minimum": "0.7.1"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ]
}
